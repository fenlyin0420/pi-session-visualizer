{
  "name": "pi-session-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop visualizer for pi coding-agent sessions",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Fenlyin",
  "repository": "https://github.com/fenlyin0420/pi-session-visualizer",
  "homepage": "https://github.com/fenlyin0420/pi-session-visualizer",
  "desktopName": "pi-session-visualizer",
  "license": "MIT",
  "keywords": [
    "pi",
    "coding-agent",
    "session",
    "jsonl",
    "visualization",
    "timeline",
    "electron",
    "local-first",
    "developer-tools"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "dev:linux": "PI_SESSION_DISABLE_GPU=1 electron-vite dev --noSandbox",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "dev.fenlyin.pi-session-visualizer",
    "productName": "Pi Session Visualizer",
    "icon": "build/icon.svg",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": [],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
